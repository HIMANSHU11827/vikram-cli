{
  "id": "guard-chmod-777",
  "name": "Guard: world-writable",
  "version": "1.0.0",
  "description": "Refuses or rewrites a tool call: world-writable.",
  "author": "VIKRAM hook catalog",
  "license": "MIT",
  "priority": 100,
  "components": {
    "hooks": [
      "tool_call"
    ]
  },
  "permissions": [
    "tools"
  ],
  "enabled": true,
  "hook_rules": [
    {
      "point": "tool_call",
      "tool": "shell.run",
      "arguments_contain": "chmod 777",
      "deny": "world-writable permissions are refused"
    }
  ]
}
